# =============================================================================
# GestionHYDRO - DEVELOPMENT Environment Sample
# =============================================================================
# Copy this file to .env for local development
# This file is safe to use as-is for local development with Docker Compose
# =============================================================================

# Environment selection
DJANGO_ENV=development

# Django core
DJANGO_SECRET_KEY=dev-only-not-for-production-key-change-in-prod-1234567890
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Database - matches docker-compose-dev.yml services
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_NAME=hydro
DATABASE_USER=root
DATABASE_PASSWORD=dev_password_change_me
MYSQL_ROOT_PASSWORD=dev_password_change_me
MYSQL_DATABASE=hydro

# Celery/Redis - matches docker-compose-dev.yml services
CELERY_BROKER=redis://redis:6379/0

# AWS/S3 - Optional in development (leave empty for local storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=gestionhydro
AWS_S3_ENDPOINT_URL=https://sfo3.digitaloceanspaces.com
AWS_LOCATION=https://gestionhydro.sfo3.digitaloceanspaces.com

# Sentry - disabled in development
SENTRY_DSN=
SENTRY_ENV=development

# CSRF
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# App secrets (optional in dev)
DELETE_CONFIRMATION_CODE=
API_SECRET=


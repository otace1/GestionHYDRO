# =============================================================================
# GestionHYDRO Environment Configuration Template
# =============================================================================
# Copy this file to .env for local development or .env.prod for production
# NEVER commit .env or .env.prod to version control
# =============================================================================

# -----------------------------------------------------------------------------
# ENVIRONMENT SELECTION
# -----------------------------------------------------------------------------
# Options: development, production, test
DJANGO_ENV=development

# -----------------------------------------------------------------------------
# DJANGO CORE SETTINGS
# -----------------------------------------------------------------------------
# In development, a random key is auto-generated if not provided
# In production, this MUST be set to a secure random string (50+ chars)
DJANGO_SECRET_KEY=

# DEBUG mode (1=True, 0=False)
# Ignored in production (always False)
DEBUG=1

# Comma-separated list of allowed hosts
# In development, defaults to localhost if not set
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_NAME=hydro
DATABASE_USER=root
DATABASE_PASSWORD=changeme

# MySQL root password (for docker-compose)
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=hydro

# Connection pool max age (seconds, production only)
DB_CONN_MAX_AGE=60

# -----------------------------------------------------------------------------
# CELERY / REDIS
# -----------------------------------------------------------------------------
CELERY_BROKER=redis://redis:6379/0

# -----------------------------------------------------------------------------
# AWS / S3 STORAGE (DigitalOcean Spaces)
# -----------------------------------------------------------------------------
# Optional in development (falls back to local storage)
# Required in production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=gestionhydro
AWS_S3_ENDPOINT_URL=https://sfo3.digitaloceanspaces.com
AWS_LOCATION=https://gestionhydro.sfo3.digitaloceanspaces.com

# -----------------------------------------------------------------------------
# SENTRY ERROR TRACKING
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENV=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0

# -----------------------------------------------------------------------------
# SECURITY & CSRF
# -----------------------------------------------------------------------------
# Comma-separated list of trusted origins for CSRF
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# APPLICATION SECRETS
# -----------------------------------------------------------------------------
DELETE_CONFIRMATION_CODE=
API_SECRET=

# -----------------------------------------------------------------------------
# PUSH NOTIFICATIONS (optional)
# -----------------------------------------------------------------------------
FCM_API_KEY=
GCM_API_KEY=

